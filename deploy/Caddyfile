# 데모 앞단 (G11-4). 지금은 HTTP만 받아 앱으로 넘긴다.
#
# G11-6에서 바뀐다: 도메인 블록 + Cloudflare Origin CA 인증서(tls 파일), 80 닫고 443만.
# 그 전까지 보안그룹이 80을 «내 IP에만» 연다 — 공개 주소가 아니다.

:80 {
	encode zstd gzip

	# 업로드 한도(앱 2MB)보다 조금 크게 — 앱이 정중하게 거절할 수 있도록 여기서 먼저 끊지 않는다
	request_body {
		max_size 3MB
	}

	reverse_proxy app:8080

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
